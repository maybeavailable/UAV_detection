{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ascend-aarch64",
      "displayName": "昇腾 aarch64 (CANN) - Debug",
      "description": "使用当前系统的昇腾 CANN 编译环境（aarch64-linux）+ aarch64-linux-gnu 交叉编译器",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/ascend-aarch64",
      "toolchainFile": "${sourceDir}/cmake/toolchain-ascend-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UAV_ASCEND": "ON"
      }
    },
    {
      "name": "ascend-aarch64-release",
      "displayName": "昇腾 aarch64 (CANN) - Release",
      "inherits": "ascend-aarch64",
      "binaryDir": "${sourceDir}/build/ascend-aarch64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native",
      "displayName": "本机 x86_64（不含昇腾环境）",
      "description": "宿主机原生编译，用于在本机调试与测试不依赖昇腾的模块（log / rtsp 等）",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UAV_ASCEND": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ascend-aarch64",
      "configurePreset": "ascend-aarch64"
    },
    {
      "name": "ascend-aarch64-release",
      "configurePreset": "ascend-aarch64-release"
    },
    {
      "name": "native",
      "configurePreset": "native"
    }
  ]
}
